# -----------------------------------------------------------------------------
# Blog identity
# -----------------------------------------------------------------------------
BLOG_SITE_NAME="Postbridge"
BLOG_SITE_DESCRIPTION="notes."
BLOG_SITE_META_DESCRIPTION="Articles and notes published with Postbridge."
BLOG_SITE_URL=https://blog.example.com
BLOG_TIMEZONE=UTC
BLOG_LANGUAGE=en
BLOG_POSTS_PER_PAGE=10

# -----------------------------------------------------------------------------
# Paths / deployment
# -----------------------------------------------------------------------------
BLOG_ROOT=/opt/postbridge
BLOG_DB=/var/lib/postbridge/blog.db
BLOG_POSTS_DIR=/var/lib/postbridge/posts
BLOG_STATE_DIR=/var/lib/postbridge/state
BLOGCTL_PATH=/opt/postbridge/bin/blogctl
BLOG_PYTHON=/opt/postbridge/.venv/bin/python

# Used by helper scripts. These do not need to live inside the repository.
BLOG_CONFIG_DIR=/etc/postbridge
BLOG_ENV_FILE=/etc/postbridge/.env

# -----------------------------------------------------------------------------
# ntfy publisher
# -----------------------------------------------------------------------------
NTFY_BASE_URL=https://ntfy.example.com
NTFY_TOPIC=blog-publish
# Create this in the ntfy web UI: Account -> Access tokens
NTFY_TOKEN=
NTFY_POLL_INTERVAL=5
NTFY_STATE_FILE=/var/lib/postbridge/ntfy-last-id
NTFY_MAX_ATTACHMENT_BYTES=5242880
NTFY_USER_AGENT=postbridge-ntfy-publisher/2.0
NTFY_SERVICE_NAME=postbridge-ntfy.service

# -----------------------------------------------------------------------------
# MCP publisher
# -----------------------------------------------------------------------------
MCP_PUBLIC_URL=https://blog.example.com
MCP_ALLOWED_HOSTS=blog.example.com
MCP_SERVER_NAME=postbridge-mcp
MCP_DISPLAY_NAME="Postbridge Publisher"
MCP_PORT=8766
MCP_TRUST_PROXY_HOPS=1
# Server-side OAuth approval key (minimum 32 characters). Example:
#   openssl rand -hex 32
# This is not an OAuth access token; keep it secret and do not commit real values.
MCP_OAUTH_APPROVAL_KEY=
MCP_OAUTH_ISSUER=https://blog.example.com
MCP_OAUTH_RESOURCE=https://blog.example.com/mcp
MCP_OAUTH_STATE_FILE=/var/lib/postbridge/mcp-oauth-state.json
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
MCP_MAX_REQUEST_BODY=4mb
