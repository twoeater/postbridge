# -----------------------------------------------------------------------------
# Blog identity
# -----------------------------------------------------------------------------
BLOG_SITE_NAME="Markdown Notes"
BLOG_SITE_DESCRIPTION="notes."
BLOG_SITE_META_DESCRIPTION="Articles and notes from Markdown Notes."
BLOG_SITE_URL=https://blog.example.com
BLOG_TIMEZONE=UTC
BLOG_LANGUAGE=en
BLOG_POSTS_PER_PAGE=10

# -----------------------------------------------------------------------------
# Paths / deployment
# -----------------------------------------------------------------------------
BLOG_ROOT=/opt/markdown-blog
BLOG_DB=/var/lib/markdown-blog/blog.db
BLOG_POSTS_DIR=/var/lib/markdown-blog/posts
BLOG_STATE_DIR=/var/lib/markdown-blog/state
BLOGCTL_PATH=/opt/markdown-blog/bin/blogctl
BLOG_PYTHON=/opt/markdown-blog/.venv/bin/python

# Used by helper scripts. These do not need to live inside the repository.
BLOG_CONFIG_DIR=/etc/markdown-blog
BLOG_ENV_FILE=/etc/markdown-blog/.env

# -----------------------------------------------------------------------------
# ntfy publisher
# -----------------------------------------------------------------------------
NTFY_BASE_URL=https://ntfy.example.com
NTFY_TOPIC=blog-publish
NTFY_TOKEN=
NTFY_POLL_INTERVAL=5
NTFY_STATE_FILE=/var/lib/markdown-blog/ntfy-last-id
NTFY_MAX_ATTACHMENT_BYTES=5242880
NTFY_USER_AGENT=markdown-blog-ntfy-publisher/2.0
NTFY_SERVICE_NAME=markdown-blog-ntfy.service

# -----------------------------------------------------------------------------
# MCP publisher
# -----------------------------------------------------------------------------
MCP_PUBLIC_URL=https://blog.example.com
MCP_ALLOWED_HOSTS=blog.example.com
MCP_SERVER_NAME=markdown-blog-mcp
MCP_DISPLAY_NAME="Markdown Blog Publisher"
MCP_PORT=8766
MCP_TRUST_PROXY_HOPS=1
MCP_OAUTH_APPROVAL_KEY=
MCP_OAUTH_ISSUER=https://blog.example.com
MCP_OAUTH_RESOURCE=https://blog.example.com/mcp
MCP_OAUTH_STATE_FILE=/var/lib/markdown-blog/mcp-oauth-state.json
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
MCP_MAX_REQUEST_BODY=4mb
