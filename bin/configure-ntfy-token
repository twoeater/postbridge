#!/bin/bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "run as root" >&2
  exit 1
fi

# Optional first argument selects the unified environment file.
config_dir=${BLOG_CONFIG_DIR:-/etc/markdown-blog}
env_file=${1:-${BLOG_ENV_FILE:-$config_dir/.env}}

# Reuse existing settings without replacing unrelated blog/MCP variables.
if [ -r "$env_file" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
fi

env_file=${1:-${BLOG_ENV_FILE:-$env_file}}
service_name=${NTFY_SERVICE_NAME:-markdown-blog-ntfy.service}
base_url=${NTFY_BASE_URL:-}
topic=${NTFY_TOPIC:-}

if [ -z "$base_url" ]; then
  read -r -p 'ntfy base URL (https://...): ' base_url
fi
if [ -z "$topic" ]; then
  read -r -p 'ntfy topic: ' topic
fi
read -r -s -p 'ntfy token: ' token
echo

if [ -z "$base_url" ] || [ -z "$topic" ] || [ -z "$token" ]; then
  echo "base URL, topic, and token are required" >&2
  exit 1
fi
case "$base_url" in
  https://*) ;;
  *) echo "ntfy base URL must use https://" >&2; exit 1 ;;
esac

install -d -m 700 "$(dirname "$env_file")"
umask 077

NTFY_NEW_BASE_URL=$base_url \
NTFY_NEW_TOPIC=$topic \
NTFY_NEW_TOKEN=$token \
python3 - "$env_file" <<'PY'
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
updates = {
    "NTFY_BASE_URL": os.environ["NTFY_NEW_BASE_URL"],
    "NTFY_TOPIC": os.environ["NTFY_NEW_TOPIC"],
    "NTFY_TOKEN": os.environ["NTFY_NEW_TOKEN"],
}


def quote(value: str) -> str:
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"') + '"'

lines = path.read_text().splitlines() if path.exists() else []
seen = set()
out = []
for line in lines:
    stripped = line.strip()
    if stripped and not stripped.startswith('#') and '=' in stripped:
        key = stripped.split('=', 1)[0].strip()
        if key in updates:
            out.append(f"{key}={quote(updates[key])}")
            seen.add(key)
            continue
    out.append(line)

missing = [key for key in updates if key not in seen]
if missing:
    if out and out[-1].strip():
        out.append('')
    if not any(line.strip() == '# ntfy' for line in out):
        out.append('# ntfy')
    out.extend(f"{key}={quote(updates[key])}" for key in missing)

path.write_text('\n'.join(out).rstrip() + '\n')
PY

unset token NTFY_NEW_TOKEN NTFY_NEW_BASE_URL NTFY_NEW_TOPIC
chmod 600 "$env_file"
systemctl daemon-reload
systemctl enable --now "$service_name"
echo "ntfy publisher enabled: $service_name"
